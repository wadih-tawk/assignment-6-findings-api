{
  "info": {
    "name": "Findings API — Assignment 6",
    "description": "Every route of the bug bounty findings REST API. Run the folders in order (Run collection). Change the baseUrl variable if your server is not on http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "findingId",
      "value": ""
    },
    {
      "key": "secondId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · CRUD",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Create a finding",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('findingId', pm.response.json()._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/findings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"SQL injection in login form\",\n  \"target\": \"https://shop.example.com/login\",\n  \"severity\": \"critical\",\n  \"description\": \"The username parameter is concatenated into a SQL query.\",\n  \"bounty\": 1500,\n  \"tags\": [\n    \"sqli\",\n    \"auth\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a second finding",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('secondId', pm.response.json()._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/findings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Stored XSS in comments\",\n  \"target\": \"https://blog.example.org/post/7\",\n  \"severity\": \"high\",\n  \"tags\": [\n    \"xss\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
